DATABASE_URL=postgres://eat:eat@localhost:5432/eat
BETTER_AUTH_URL=http://localhost:3000
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Comma-separated emails allowed to sign in and become Members.
ALLOWED_EMAILS=you@example.com
# Without RESEND_API_KEY, sign-in emails go to the email_outbox table (not allowed in production).
# RESEND_API_KEY=
# EMAIL_FROM=Eat <eat@your-domain>
